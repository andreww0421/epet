{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "epet-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/**", "!/assets/**"]
  },
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "BOT_PROTECTION_REQUIRED": "false",
    "EMAIL_VERIFICATION_REQUIRED": "false",
    "PUBLIC_APP_URL": "https://epet-api.jtwen12345us.workers.dev/",
    "REGISTRATION_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "epet-production",
      "database_id": "bd5c5ef9-7910-4733-85ab-b17cd72d2689",
      "migrations_dir": "migrations"
    }
  ]
}
