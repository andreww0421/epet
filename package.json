{
  "name": "epet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "dev:full": "node scripts/dev-full.mjs",
    "dev:worker": "wrangler dev",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:rules": "tsx tests/gameRules.test.ts",
    "test:server": "tsx tests/server.test.ts",
    "test": "npm run test:rules && npm run test:server",
    "check:worker": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply epet-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply epet-production --remote",
    "deploy:worker": "wrangler deploy",
    "verify": "npm run lint && npm test && npm run build && npm run check:worker"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^8.1.5",
    "wrangler": "^4.115.0"
  }
}
